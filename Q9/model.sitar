module Top
    submodule IM : Memory<>
    submodule DM : Memory<>
    submodule C : Core

    net c_im_request : capacity 1 width 6
    net im_c_response : capacity 1 width 17

    net c_dm_request : capacity 1 width 6
    net dm_c_response : capacity 1 width 17

    C.im_inp <= im_c_response
    IM.outp => im_c_response
    C.im_outp => c_im_request
    IM.inp <= c_im_request

    C.dm_inp <= dm_c_response
    DM.outp => dm_c_response
    C.dm_outp => c_dm_request
    DM.inp <= c_dm_request
end module


// Processor generates memory access patterns
procedure Processor

    parameter int P_LOAD = 40
    parameter int P_STORE = 30
    parameter int EXECUTION_DELAY = 3
    parameter int TOTAL_INSTRUCTIONS = 1000
    parameter int MAX_TIME = 100000
    parameter int BLOCK_SIZE = 16

    include $#include <cstdlib>$
    include $#include <cstdint>$

    decl $
        enum MemOpType {
            IFETCH = 0,
            LOAD = 1,
            STORE = 2,
            ATOMICLOADSTORE = 3
        };

        enum MemSize {
            WORD = 0,
            DOUBLEWORD = 1,
            QUADWORD = 2
        };

        int instr_count;

        uint32_t requestAddr;
        uint8_t requestType;
        uint8_t requestSize;

        uint8_t responseErr;
        uint32_t responseData0;
        uint32_t responseData1;
        uint32_t responseData2;
        uint32_t responseData3;

        bool hasToken;
        bool keepRunning;

        bool do_load;
        bool do_store;

        double TEMPORAL_LOCALITY;
        double SPATIAL_LOCALITY;

        static const uint32_t ADDR_SPACE = 1024;
        static const int HISTORY_SIZE = 8;

        uint32_t addrHistory[HISTORY_SIZE];

        int histCount;
        int histPos;

        uint32_t prevAddr;
        bool havePrev;

        // ICACHE interface pointers
        bool *ic_req_valid;
        bool *ic_resp_valid;

        uint32_t *ic_req_addr;
        uint8_t *ic_req_type;
        uint8_t *ic_req_size;

        uint8_t *ic_resp_err;

        uint32_t *ic_resp_data0;
        uint32_t *ic_resp_data1;
        uint32_t *ic_resp_data2;
        uint32_t *ic_resp_data3;

        // DCACHE interface pointers
        bool *dc_req_valid;
        bool *dc_resp_valid;

        uint32_t *dc_req_addr;
        uint8_t *dc_req_type;
        uint8_t *dc_req_size;

        uint8_t *dc_resp_err;

        uint32_t *dc_resp_data0;
        uint32_t *dc_resp_data1;
        uint32_t *dc_resp_data2;
        uint32_t *dc_resp_data3;


        double frand01() {
            return (rand() % 1000000) / 1000000.0;
        }


        uint32_t genAddress() {

            uint32_t addr;

            if(havePrev && frand01() < SPATIAL_LOCALITY) {

                uint32_t blockStart =
                    prevAddr & ~((uint32_t)BLOCK_SIZE - 1);

                addr = blockStart +
                    4 * (uint32_t)(rand() % (BLOCK_SIZE / 4));

            }
            else if(histCount > 0 &&
                    frand01() < TEMPORAL_LOCALITY) {

                addr = addrHistory[rand() % histCount];

            }
            else {

                addr = 4 * (uint32_t)(rand() % (ADDR_SPACE / 4));

            }

            addrHistory[histPos] = addr;

            histPos = (histPos + 1) % HISTORY_SIZE;

            if(histCount < HISTORY_SIZE)
                histCount++;

            prevAddr = addr;
            havePrev = true;

            return addr;
        }


        int getSizeBytes(int size) {

            if(size == WORD) return 4;
            if(size == DOUBLEWORD) return 8;

            return 16;
        }


        uint32_t alignAddr(uint32_t addr, int size) {

            if(size == WORD)
                return addr & ~3u;

            if(size == DOUBLEWORD)
                return addr & ~7u;

            return addr & ~15u;
        }


        void sendICacheRequest(
            uint32_t addr,
            uint8_t type,
            uint8_t size
        ) {

            *ic_req_addr = addr;
            *ic_req_type = type;
            *ic_req_size = size;

            *ic_resp_valid = false;

            *ic_req_valid = true;
        }


        void sendDCacheRequest(
            uint32_t addr,
            uint8_t type,
            uint8_t size
        ) {

            *dc_req_addr = addr;
            *dc_req_type = type;
            *dc_req_size = size;

            *dc_resp_valid = false;

            *dc_req_valid = true;
        }


        void printData(int size) {

            int bytes = getSizeBytes(size);

            uint32_t d[4] = {
                responseData0,
                responseData1,
                responseData2,
                responseData3
            };

            log << " data=";

            for(int i = 0; i < bytes / 4; i++) {

                log
                    << ((d[i] >> 24) & 0xff) << " "
                    << ((d[i] >> 16) & 0xff) << " "
                    << ((d[i] >> 8) & 0xff) << " "
                    << (d[i] & 0xff) << " ";

            }
        }

    $


    init $

        instr_count = 0;

        histCount = 0;
        histPos = 0;

        prevAddr = 0;
        havePrev = false;

        TEMPORAL_LOCALITY = 0.8;
        SPATIAL_LOCALITY = 0.7;

        if(const char* e = std::getenv("TEMPORAL_LOCALITY"))
            TEMPORAL_LOCALITY = std::atof(e);

        if(const char* e = std::getenv("SPATIAL_LOCALITY"))
            SPATIAL_LOCALITY = std::atof(e);

    $


    behavior

        do

            // Instruction fetch from icache
            $

                if(instr_count == 0) {

                    log << endl
                        << "LOCALITY temporal="
                        << TEMPORAL_LOCALITY
                        << " spatial="
                        << SPATIAL_LOCALITY;

                }

                requestType = IFETCH;
                requestSize = WORD;

                requestAddr =
                    alignAddr(genAddress(), WORD);

                log << endl
                    << "IFETCH addr="
                    << requestAddr;

                sendICacheRequest(
                    requestAddr,
                    requestType,
                    requestSize
                );
            $;


            // Wait for icache response
            do

                $
                    hasToken = *ic_resp_valid;
                $;

                if(not hasToken) then
                    wait
                end if;

            while(not hasToken) end do;


            // Consume icache response
            $
                responseErr = *ic_resp_err;

                responseData0 = *ic_resp_data0;
                responseData1 = *ic_resp_data1;
                responseData2 = *ic_resp_data2;
                responseData3 = *ic_resp_data3;

                *ic_resp_valid = false;

                if(responseErr != 0) {

                    log << endl
                        << "IFETCH ERROR="
                        << (int)responseErr;

                }
                else {

                    log << endl << "IFETCH OK";

                    printData(WORD);

                }
            $;


            // Execution delay
            wait(EXECUTION_DELAY, 0);

            $
                do_load =
                    (rand() % 100) < P_LOAD;

                do_store =
                    (rand() % 100) < P_STORE;
            $;


            // LOAD operation
            if(do_load) then

                $
                    requestType = LOAD;

                    requestSize = rand() % 3;

                    requestAddr =
                        alignAddr(
                            genAddress(),
                            requestSize
                        );

                    log << endl
                        << "LOAD addr="
                        << requestAddr
                        << " size="
                        << (int)requestSize;

                    sendDCacheRequest(
                        requestAddr,
                        requestType,
                        requestSize
                    );
                $;


                do

                    $
                        hasToken = *dc_resp_valid;
                    $;

                    if(not hasToken) then
                        wait
                    end if;

                while(not hasToken) end do;

                $
                    responseErr = *dc_resp_err;

                    responseData0 = *dc_resp_data0;
                    responseData1 = *dc_resp_data1;
                    responseData2 = *dc_resp_data2;
                    responseData3 = *dc_resp_data3;

                    *dc_resp_valid = false;

                    if(responseErr != 0) {

                        log << endl
                            << "LOAD ERROR="
                            << (int)responseErr;

                    }
                    else {

                        log << endl << "LOAD OK";

                        printData(requestSize);

                    }
                $;

            end if;


            // STORE operation
            if(do_store) then

                $
                    requestType = STORE;

                    requestSize = rand() % 3;

                    requestAddr =
                        alignAddr(
                            genAddress(),
                            requestSize
                        );

                    log << endl
                        << "STORE addr="
                        << requestAddr
                        << " size="
                        << (int)requestSize;

                    sendDCacheRequest(
                        requestAddr,
                        requestType,
                        requestSize
                    );
                $;


                do

                    $
                        hasToken = *dc_resp_valid;
                    $;

                    if(not hasToken) then
                        wait
                    end if;

                while(not hasToken) end do;

                $
                    responseErr = *dc_resp_err;

                    responseData0 = *dc_resp_data0;
                    responseData1 = *dc_resp_data1;
                    responseData2 = *dc_resp_data2;
                    responseData3 = *dc_resp_data3;

                    *dc_resp_valid = false;

                    if(responseErr != 0) {

                        log << endl
                            << "STORE ERROR="
                            << (int)responseErr;

                    }
                    else {

                        log << endl << "STORE OK";

                    }
                $;

            end if;


            // Instruction complete
            $
                instr_count++;

                log << endl
                    << "INSTRUCTION "
                    << instr_count
                    << " COMPLETE";

                keepRunning =
                    (instr_count < TOTAL_INSTRUCTIONS) &&
                    (current_time.cycle() < MAX_TIME);
            $;

        while(keepRunning) end do;


        // Request icache statistics
        $
            sendICacheRequest(
                0xFFFFFFFF,
                IFETCH,
                WORD
            );
        $;

        do

            $
                hasToken = *ic_resp_valid;
            $;

            if(not hasToken) then
                wait
            end if;

        while(not hasToken) end do;

        $
            *ic_resp_valid = false;
        $;


        // Request dcache statistics
        $
            sendDCacheRequest(
                0xFFFFFFFF,
                IFETCH,
                WORD
            );
        $;

        do

            $
                hasToken = *dc_resp_valid;
            $;

            if(not hasToken) then
                wait
            end if;

        while(not hasToken) end do;

        $
            *dc_resp_valid = false;

            if(instr_count >= TOTAL_INSTRUCTIONS) {

                log << endl
                    << "Completed "
                    << TOTAL_INSTRUCTIONS
                    << " instructions";

            }
            else {

                log << endl
                    << "TIME LIMIT EXCEEDED at cycle "
                    << current_time.cycle();

            }
        $;

        stop simulation;

    end behavior

end procedure



// Set-Associative Cache with Write-Back Support
// Q9 Extension: Added DIRTY bit for write-back behavior
// NUM_SETS: number of sets in the cache
// NUM_WAYS: number of blocks per set (associativity)
// BLOCK_SIZE: bytes per cache block
// Total cache size = NUM_SETS * NUM_WAYS * BLOCK_SIZE
procedure Cache

    parameter int NUM_SETS = 4
    parameter int NUM_WAYS = 4
    parameter int BLOCK_SIZE = 16
    parameter int CACHE_DELAY = 4

    include $#include <cstdlib>$
    include $#include <vector>$
    include $#include <cstdint>$
    include $#include <cmath>$

    decl $

        enum MemOpType {
            IFETCH = 0,
            LOAD = 1,
            STORE = 2,
            ATOMICLOADSTORE = 3
        };

        enum MemSize {
            WORD = 0,
            DOUBLEWORD = 1,
            QUADWORD = 2
        };

        enum CacheStatus {
            MISS = -1,
            HIT = 1
        };


        // Cache line structure with DIRTY bit (Q9 addition)
        class CacheLine {

            public:

                bool validBit;
                bool dirtyBit;
                uint32_t tagBit;
                std::vector<uint8_t> data;

                CacheLine() {
                    validBit = false;
                    dirtyBit = false;
                    tagBit = 0;
                    data.resize(BLOCK_SIZE, 0);
                }
        };


        // Cache organized as sets of ways: cache[set][way]
        std::vector<std::vector<CacheLine>> cache;


        // Processor interface (shared variables)
        bool req_valid;
        bool resp_valid;

        uint32_t req_addr;
        uint8_t req_type;
        uint8_t req_size;

        uint8_t resp_err;

        uint32_t resp_data0;
        uint32_t resp_data1;
        uint32_t resp_data2;
        uint32_t resp_data3;


        // Memory interface
        token<6> requestToMemory;
        token<17> responseFromMemory;

        uint32_t requestAddr;
        uint8_t requestType;
        uint8_t requestSize;

        uint8_t responseErr;

        uint32_t responseData0;
        uint32_t responseData1;
        uint32_t responseData2;
        uint32_t responseData3;


        int cacheStatus;
        bool hasToken;
        bool ok;
        bool pulled;
        bool isStatRequest;

        // Write-back / victim state (kept in decl so it is visible across code blocks)
        uint32_t wb_setIdx;
        int wb_victimWay;
        bool wb_needWriteback;
        uint32_t wb_victimAddr;

        // Statistics
        long statTotal;
        long statHits;
        long statMisses;
        long statWritebacks;


        // Convert size enum to bytes
        int getSizeBytes(int size) {

            if(size == WORD) return 4;
            if(size == DOUBLEWORD) return 8;

            return 16;
        }


        // Check alignment
        bool isAligned(uint32_t addr, int size) {

            if(size == WORD)
                return (addr & 3) == 0;

            if(size == DOUBLEWORD)
                return (addr & 7) == 0;

            return (addr & 15) == 0;
        }


        // TAG = address / (BLOCK_SIZE * NUM_SETS)
        uint32_t get_tag(uint32_t addr) {

            return addr / (BLOCK_SIZE * NUM_SETS);

        }


        // SET = (address / BLOCK_SIZE) % NUM_SETS
        uint32_t get_set_index(uint32_t addr) {

            return (addr / BLOCK_SIZE) % NUM_SETS;

        }


        // Byte offset within block
        uint32_t get_offset(uint32_t addr) {

            return addr % BLOCK_SIZE;

        }


        // Find which way holds a tag (if any)
        int find_way(uint32_t tag, uint32_t setIdx) {

            for(int way = 0; way < NUM_WAYS; way++) {
                if(cache[setIdx][way].validBit &&
                   cache[setIdx][way].tagBit == tag) {
                    return way;
                }
            }
            return -1;
        }


        // Read from set-associative cache
        int read_cache(uint32_t addr, int size) {

            responseData0 = 0;
            responseData1 = 0;
            responseData2 = 0;
            responseData3 = 0;

            uint32_t tag = get_tag(addr);
            uint32_t setIdx = get_set_index(addr);
            uint32_t offset = get_offset(addr);

            int bytes = getSizeBytes(size);

            if(offset + bytes > BLOCK_SIZE)
                return MISS;


            for(int way = 0; way < NUM_WAYS; way++) {

                if(cache[setIdx][way].validBit &&
                   cache[setIdx][way].tagBit == tag) {

                    uint32_t d[4] = {0, 0, 0, 0};

                    for(int j = 0; j < bytes / 4; j++) {

                        int k = offset + j * 4;

                        d[j] =
                            ((uint32_t)cache[setIdx][way].data[k] << 24) |
                            ((uint32_t)cache[setIdx][way].data[k+1] << 16) |
                            ((uint32_t)cache[setIdx][way].data[k+2] << 8) |
                            ((uint32_t)cache[setIdx][way].data[k+3]);

                    }

                    responseData0 = d[0];
                    responseData1 = d[1];
                    responseData2 = d[2];
                    responseData3 = d[3];

                    return HIT;

                }
            }

            return MISS;
        }


        // Fill the store payload (simulated processor write data)
        void set_store_data() {

            responseData0 = 0xAABBCCDD;
            responseData1 = 0xAABBCCDD;
            responseData2 = 0xAABBCCDD;
            responseData3 = 0xAABBCCDD;

        }


        // Write responseData into the cache block at the request offset (STORE)
        void write_data_to_cache(uint32_t addr, int size) {

            uint32_t setIdx = get_set_index(addr);
            uint32_t offset = get_offset(addr);

            int bytes = getSizeBytes(size);

            uint32_t d[4] = {
                responseData0,
                responseData1,
                responseData2,
                responseData3
            };

            int way = find_way(get_tag(addr), setIdx);
            if(way < 0) return;

            for(int i = 0; i < bytes / 4; i++) {

                int k = offset + i * 4;

                cache[setIdx][way].data[k] =
                    (d[i] >> 24) & 0xff;
                cache[setIdx][way].data[k+1] =
                    (d[i] >> 16) & 0xff;
                cache[setIdx][way].data[k+2] =
                    (d[i] >> 8) & 0xff;
                cache[setIdx][way].data[k+3] =
                    d[i] & 0xff;

            }

            // Block modified: DIRTY = 1
            cache[setIdx][way].dirtyBit = true;

        }


        // Read entire block for write-back to memory
        void read_block_for_writeback(uint32_t setIdx, int way) {

            uint32_t d[4] = {0, 0, 0, 0};

            for(int i = 0; i < BLOCK_SIZE / 4; i++) {

                int k = i * 4;

                d[i] =
                    ((uint32_t)cache[setIdx][way].data[k] << 24) |
                    ((uint32_t)cache[setIdx][way].data[k+1] << 16) |
                    ((uint32_t)cache[setIdx][way].data[k+2] << 8) |
                    ((uint32_t)cache[setIdx][way].data[k+3]);

            }

            responseData0 = d[0];
            responseData1 = d[1];
            responseData2 = d[2];
            responseData3 = d[3];

        }


        // Block address from tag and set index
        uint32_t get_block_addr_from_tag_set(uint32_t tag, uint32_t setIdx) {

            return (tag * NUM_SETS + setIdx) * BLOCK_SIZE;

        }


        // Select victim way for eviction
        int select_victim_way(uint32_t setIdx) {

            // Invalid way first
            for(int way = 0; way < NUM_WAYS; way++) {
                if(!cache[setIdx][way].validBit) {
                    return way;
                }
            }

            // All ways valid: random victim
            return rand() % NUM_WAYS;

        }


        // Install the fetched block (in responseData0..3) into the chosen way
        void write_cache(uint32_t addr, int replaceWay) {

            uint32_t tag = get_tag(addr);
            uint32_t setIdx = get_set_index(addr);

            uint32_t d[4] = {
                responseData0,
                responseData1,
                responseData2,
                responseData3
            };

            for(int i = 0; i < BLOCK_SIZE; i++) {

                int word = i / 4;
                int byte = i % 4;

                cache[setIdx][replaceWay].data[i] =
                    (d[word] >> (24 - byte * 8)) & 0xff;

            }

            cache[setIdx][replaceWay].tagBit = tag;
            cache[setIdx][replaceWay].validBit = true;
            cache[setIdx][replaceWay].dirtyBit = false;  // fresh block = clean

        }


        // Prepare memory request
        void prepareMemoryRequest(
            uint32_t addr,
            uint8_t type,
            uint8_t size
        ) {

            sitar::pack(
                requestToMemory,
                addr,
                type,
                size
            );

        }


        // Pointers to Core's memory ports
        inport<17>* m_inp;
        outport<6>* m_outp;
    $

    init $

        cache.resize(NUM_SETS);
        for(int i = 0; i < NUM_SETS; i++) {
            cache[i].resize(NUM_WAYS);
        }

        req_valid = false;
        resp_valid = false;

        req_addr = 0;
        req_type = 0;
        req_size = 0;

        resp_err = 0;

        resp_data0 = 0;
        resp_data1 = 0;
        resp_data2 = 0;
        resp_data3 = 0;

        statTotal = 0;
        statHits = 0;
        statMisses = 0;
        statWritebacks = 0;

    $


    behavior

        do

            // Wait for processor request
            do

                $
                    hasToken = req_valid;
                $;

                if(not hasToken) then
                    wait
                end if;

            while(not hasToken) end do;


            // Accept request from processor
            $
                requestAddr = req_addr;
                requestType = req_type;
                requestSize = req_size;

                req_valid = false;

                responseErr = 0;

                responseData0 = 0;
                responseData1 = 0;
                responseData2 = 0;
                responseData3 = 0;

                isStatRequest =
                    (requestAddr == 0xFFFFFFFF);

            $;


            // Handle statistics request
            if(isStatRequest) then

                $
                    log << endl
                        << "CACHE STATISTICS"
                        << " (config: sets="
                        << NUM_SETS
                        << " ways="
                        << NUM_WAYS
                        << " blockSize="
                        << BLOCK_SIZE << ")";

                    log << endl
                        << "requests="
                        << statTotal
                        << " hits="
                        << statHits
                        << " misses="
                        << statMisses
                        << " writebacks="
                        << statWritebacks;

                    log << endl
                        << "p_hit="
                        << (
                            statTotal > 0
                            ? (double)statHits / statTotal
                            : 0.0
                        );

                    log << endl
                        << "p_writeback_per_miss="
                        << (
                            statMisses > 0
                            ? (double)statWritebacks / statMisses
                            : 0.0
                        );
                $;

            else

                // Alignment check
                if(not isAligned(requestAddr, requestSize)) then

                    $
                        responseErr = 2;

                        log << endl
                            << "CACHE ALIGNMENT ERROR "
                            << requestAddr;
                    $;

                else

                    //  STORE (write-back)
                    if(requestType == STORE) then

                        $
                            cacheStatus =
                                read_cache(
                                    requestAddr,
                                    requestSize
                                );
                        $;


                        if(cacheStatus == HIT) then

                            // STORE hit: update cache, DIRTY = 1
                            $
                                statTotal++;
                                statHits++;

                                set_store_data();

                                write_data_to_cache(
                                    requestAddr,
                                    requestSize
                                );

                                log << endl
                                    << "Cache STORE HIT (write-back)"
                                    << " dirty=1";
                            $;

                        else

                            // STORE miss
                            $
                                statTotal++;
                                statMisses++;

                                log << endl
                                    << "Cache STORE MISS";
                            $;


                            // Select victim
                            $
                                wb_setIdx = get_set_index(requestAddr);
                                wb_victimWay = select_victim_way(wb_setIdx);

                                wb_needWriteback =
                                    cache[wb_setIdx][wb_victimWay].validBit &&
                                    cache[wb_setIdx][wb_victimWay].dirtyBit;

                                wb_victimAddr = 0;

                                if(wb_needWriteback) {
                                    wb_victimAddr =
                                        get_block_addr_from_tag_set(
                                            cache[wb_setIdx][wb_victimWay].tagBit,
                                            wb_setIdx
                                        );
                                }
                            $;


                            // Write back dirty victim if needed
                            if(wb_needWriteback) then

                                $
                                    statWritebacks++;

                                    read_block_for_writeback(
                                        wb_setIdx,
                                        wb_victimWay
                                    );

                                    uint8_t blockSize;

                                    if(BLOCK_SIZE == 4)
                                        blockSize = WORD;
                                    else if(BLOCK_SIZE == 8)
                                        blockSize = DOUBLEWORD;
                                    else
                                        blockSize = QUADWORD;

                                    prepareMemoryRequest(
                                        wb_victimAddr,
                                        STORE,
                                        blockSize
                                    );

                                    log << endl
                                        << "WRITE-BACK victim="
                                        << wb_victimAddr
                                        << " (dirty block)";
                                $;


                                // Send write-back to memory
                                do

                                    wait until(this_phase == 1);

                                    $
                                        ok = m_outp->push(requestToMemory);
                                    $;

                                    if(not ok) then
                                        wait
                                    end if;

                                while(not ok) end do;


                                // Memory response for write-back
                                do

                                    wait until(this_phase == 0);

                                    $
                                        hasToken =
                                            m_inp->peek(responseFromMemory);
                                    $;

                                    if(not hasToken) then
                                        wait
                                    end if;

                                while(not hasToken) end do;

                                $
                                    pulled =
                                        m_inp->pull(responseFromMemory);

                                    sitar::unpack(
                                        responseFromMemory,
                                        responseErr,
                                        responseData0,
                                        responseData1,
                                        responseData2,
                                        responseData3
                                    );

                                    log << endl
                                        << "WRITE-BACK complete";
                                $;

                            end if;


                            // Fetch requested block from memory
                            $
                                uint32_t blockAddr =
                                    requestAddr & ~((uint32_t)BLOCK_SIZE - 1);

                                uint8_t blockSize;

                                if(BLOCK_SIZE == 4)
                                    blockSize = WORD;
                                else if(BLOCK_SIZE == 8)
                                    blockSize = DOUBLEWORD;
                                else
                                    blockSize = QUADWORD;

                                prepareMemoryRequest(
                                    blockAddr,
                                    LOAD,
                                    blockSize
                                );

                                log << endl
                                    << "FETCH block="
                                    << blockAddr;
                            $;


                            // Send fetch request
                            do

                                wait until(this_phase == 1);

                                $
                                    ok = m_outp->push(requestToMemory);
                                $;

                                if(not ok) then
                                    wait
                                end if;

                            while(not ok) end do;


                            // Fetch response
                            do

                                wait until(this_phase == 0);

                                $
                                    hasToken =
                                        m_inp->peek(responseFromMemory);
                                $;

                                if(not hasToken) then
                                    wait
                                end if;

                            while(not hasToken) end do;

                            $
                                pulled =
                                    m_inp->pull(responseFromMemory);

                                sitar::unpack(
                                    responseFromMemory,
                                    responseErr,
                                    responseData0,
                                    responseData1,
                                    responseData2,
                                    responseData3
                                );

                                if(responseErr == 0) {
                                    // Install in the SAME way that was written back
                                    write_cache(requestAddr, wb_victimWay);

                                    log << endl
                                        << "BLOCK INSTALLED dirty=0";
                                }
                            $;


                            // Perform the STORE into the new block
                            $
                                if(responseErr == 0) {

                                    set_store_data();

                                    write_data_to_cache(
                                        requestAddr,
                                        requestSize
                                    );

                                    log << endl
                                        << "STORE to new block dirty=1";
                                }
                            $;

                        end if;

                    else

                        // NOTE: no "else if" - nested if with its own end if
                        if(requestType == ATOMICLOADSTORE) then

                            // Atomic operations: write-through for simplicity
                            $
                                statTotal++;
                                statMisses++;

                                prepareMemoryRequest(
                                    requestAddr,
                                    requestType,
                                    requestSize
                                );

                                log << endl
                                    << "CACHE ATOMIC WRITE-THROUGH";
                            $;


                            do

                                wait until(this_phase == 1);

                                $
                                    ok = m_outp->push(requestToMemory);
                                $;

                                if(not ok) then
                                    wait
                                end if;

                            while(not ok) end do;


                            do

                                wait until(this_phase == 0);

                                $
                                    hasToken =
                                        m_inp->peek(responseFromMemory);
                                $;

                                if(not hasToken) then
                                    wait
                                end if;

                            while(not hasToken) end do;

                            $
                                pulled =
                                    m_inp->pull(responseFromMemory);

                                sitar::unpack(
                                    responseFromMemory,
                                    responseErr,
                                    responseData0,
                                    responseData1,
                                    responseData2,
                                    responseData3
                                );
                            $;

                        else

                            // IFETCH / LOAD: check cache first
                            $
                                cacheStatus =
                                    read_cache(
                                        requestAddr,
                                        requestSize
                                    );
                            $;


                            if(cacheStatus == HIT) then

                                $
                                    statTotal++;
                                    statHits++;

                                    log << endl << "Cache HIT";
                                $;

                            else

                                $
                                    statTotal++;
                                    statMisses++;

                                    log << endl << "Cache MISS";
                                $;


                                // Select victim, check if write-back needed
                                $
                                    wb_setIdx = get_set_index(requestAddr);
                                    wb_victimWay = select_victim_way(wb_setIdx);

                                    wb_needWriteback =
                                        cache[wb_setIdx][wb_victimWay].validBit &&
                                        cache[wb_setIdx][wb_victimWay].dirtyBit;

                                    wb_victimAddr = 0;

                                    if(wb_needWriteback) {
                                        wb_victimAddr =
                                            get_block_addr_from_tag_set(
                                                cache[wb_setIdx][wb_victimWay].tagBit,
                                                wb_setIdx
                                            );
                                    }
                                $;


                                if(wb_needWriteback) then

                                    $
                                        statWritebacks++;

                                        read_block_for_writeback(
                                            wb_setIdx,
                                            wb_victimWay
                                        );

                                        uint8_t blockSize;

                                        if(BLOCK_SIZE == 4)
                                            blockSize = WORD;
                                        else if(BLOCK_SIZE == 8)
                                            blockSize = DOUBLEWORD;
                                        else
                                            blockSize = QUADWORD;

                                        prepareMemoryRequest(
                                            wb_victimAddr,
                                            STORE,
                                            blockSize
                                        );

                                        log << endl
                                            << "WRITE-BACK victim="
                                            << wb_victimAddr
                                            << " (dirty block on read miss)";
                                    $;


                                    do

                                        wait until(this_phase == 1);

                                        $
                                            ok = m_outp->push(requestToMemory);
                                        $;

                                        if(not ok) then
                                            wait
                                        end if;

                                    while(not ok) end do;


                                    do

                                        wait until(this_phase == 0);

                                        $
                                            hasToken =
                                                m_inp->peek(responseFromMemory);
                                        $;

                                        if(not hasToken) then
                                            wait
                                        end if;

                                    while(not hasToken) end do;

                                    $
                                        pulled =
                                            m_inp->pull(responseFromMemory);

                                        sitar::unpack(
                                            responseFromMemory,
                                            responseErr,
                                            responseData0,
                                            responseData1,
                                            responseData2,
                                            responseData3
                                        );

                                        log << endl
                                            << "WRITE-BACK complete";
                                    $;

                                end if;


                                // Fetch block from memory
                                $
                                    uint32_t blockAddr =
                                        requestAddr & ~((uint32_t)BLOCK_SIZE - 1);

                                    uint8_t blockSize;

                                    if(BLOCK_SIZE == 4)
                                        blockSize = WORD;
                                    else if(BLOCK_SIZE == 8)
                                        blockSize = DOUBLEWORD;
                                    else
                                        blockSize = QUADWORD;

                                    prepareMemoryRequest(
                                        blockAddr,
                                        LOAD,
                                        blockSize
                                    );
                                $;


                                do

                                    wait until(this_phase == 1);

                                    $
                                        ok =
                                            m_outp->push(requestToMemory);
                                    $;

                                    if(not ok) then
                                        wait
                                    end if;

                                while(not ok) end do;


                                do

                                    wait until(this_phase == 0);

                                    $
                                        hasToken =
                                            m_inp->peek(responseFromMemory);
                                    $;

                                    if(not hasToken) then
                                        wait
                                    end if;

                                while(not hasToken) end do;

                                $
                                    pulled =
                                        m_inp->pull(responseFromMemory);

                                    sitar::unpack(
                                        responseFromMemory,
                                        responseErr,
                                        responseData0,
                                        responseData1,
                                        responseData2,
                                        responseData3
                                    );

                                    if(responseErr == 0) {
                                        // Install in the SAME way that was written back
                                        write_cache(requestAddr, wb_victimWay);

                                        // Read back the requested data
                                        read_cache(
                                            requestAddr,
                                            requestSize
                                        );
                                    }
                                $;

                            end if;     // closes: cacheStatus == HIT

                        end if;         // closes: ATOMICLOADSTORE

                    end if;             // closes: STORE

                end if;                 // closes: alignment check

            end if;                     // closes: isStatRequest


            // Cache access delay
            wait(CACHE_DELAY, 0);


            // Send response to processor
            $
                resp_err = responseErr;

                resp_data0 = responseData0;
                resp_data1 = responseData1;
                resp_data2 = responseData2;
                resp_data3 = responseData3;

                resp_valid = true;
            $;


            // Wait for processor to consume response
            do

                $
                    hasToken = resp_valid;
                $;

                if(hasToken) then
                    wait
                end if;

            while(hasToken) end do;

        while(1) end do;

    end behavior

end procedure



// Core module: Processor + ICACHE + DCACHE
module Core

    procedure proc : Processor<40, 30, 3, 1000, 100000, 16>

    // ICACHE: 4 sets, 4 ways = 16 blocks total (256 bytes)
    procedure icache : Cache<4, 4, 16>

    // DCACHE: 2 sets, 8 ways = 16 blocks total (256 bytes)
    procedure dcache : Cache<2, 8, 16>


    // Instruction memory ports
    inport im_inp : width 17
    outport im_outp : width 6


    // Data memory ports
    inport dm_inp : width 17
    outport dm_outp : width 6

    decl $
    $


    // Connect shared variables
    init $

        // Connect caches to memory ports
        icache.m_inp = &im_inp;
        icache.m_outp = &im_outp;

        dcache.m_inp = &dm_inp;
        dcache.m_outp = &dm_outp;

        // Processor <-> ICACHE
        proc.ic_req_valid = &icache.req_valid;
        proc.ic_resp_valid = &icache.resp_valid;

        proc.ic_req_addr = &icache.req_addr;
        proc.ic_req_type = &icache.req_type;
        proc.ic_req_size = &icache.req_size;

        proc.ic_resp_err = &icache.resp_err;

        proc.ic_resp_data0 = &icache.resp_data0;
        proc.ic_resp_data1 = &icache.resp_data1;
        proc.ic_resp_data2 = &icache.resp_data2;
        proc.ic_resp_data3 = &icache.resp_data3;


        // Processor <-> DCACHE
        proc.dc_req_valid = &dcache.req_valid;
        proc.dc_resp_valid = &dcache.resp_valid;

        proc.dc_req_addr = &dcache.req_addr;
        proc.dc_req_type = &dcache.req_type;
        proc.dc_req_size = &dcache.req_size;

        proc.dc_resp_err = &dcache.resp_err;

        proc.dc_resp_data0 = &dcache.resp_data0;
        proc.dc_resp_data1 = &dcache.resp_data1;
        proc.dc_resp_data2 = &dcache.resp_data2;
        proc.dc_resp_data3 = &dcache.resp_data3;

    $


    // Run all components in parallel
    behavior

        [
            run proc
            ||
            run icache
            ||
            run dcache
        ];

    end behavior

end module



// Memory module
module Memory

    parameter int MEMORY_DELAY = 2

    inport inp : width 6
    outport outp : width 17


    include $#include <cstdlib>$
    include $#include <vector>$
    include $#include <cstdint>$


    decl $

        enum MemOpType {
            IFETCH = 0,
            LOAD = 1,
            STORE = 2,
            ATOMICLOADSTORE = 3
        };

        enum MemSize {
            WORD = 0,
            DOUBLEWORD = 1,
            QUADWORD = 2
        };


        std::vector<uint8_t> mem;


        token<6> requestFromCache;
        token<17> responseToCache;

        uint32_t requestAddr;

        uint8_t requestType;
        uint8_t requestSize;

        uint8_t responseErr;

        uint32_t responseData0;
        uint32_t responseData1;
        uint32_t responseData2;
        uint32_t responseData3;


        bool pulled;
        bool ok;
        bool hasToken;

        int getSizeBytes(int size) {

            if(size == WORD) return 4;

            if(size == DOUBLEWORD) return 8;

            return 16;
        }


        bool isAligned(uint32_t addr, int size) {

            if(size == WORD)
                return (addr & 3) == 0;

            if(size == DOUBLEWORD)
                return (addr & 7) == 0;

            return (addr & 15) == 0;
        }


        void read_memory(uint32_t addr, int size) {

            responseData0 = 0;
            responseData1 = 0;
            responseData2 = 0;
            responseData3 = 0;

            uint32_t d[4] = {0, 0, 0, 0};

            int bytes = getSizeBytes(size);

            for(int i = 0; i < bytes / 4; i++) {

                int k = addr + i * 4;

                d[i] =
                    ((uint32_t)mem[k] << 24) |
                    ((uint32_t)mem[k+1] << 16) |
                    ((uint32_t)mem[k+2] << 8) |
                    ((uint32_t)mem[k+3]);

            }

            responseData0 = d[0];
            responseData1 = d[1];
            responseData2 = d[2];
            responseData3 = d[3];

        }


        void write_word(uint32_t addr, uint32_t data) {

            mem[addr] =
                (data >> 24) & 0xff;

            mem[addr+1] =
                (data >> 16) & 0xff;

            mem[addr+2] =
                (data >> 8) & 0xff;

            mem[addr+3] =
                data & 0xff;

        }

        void write_block(uint32_t addr, int size) {

            uint32_t d[4] = {
                responseData0,
                responseData1,
                responseData2,
                responseData3
            };

            int bytes = getSizeBytes(size);

            for(int i = 0; i < bytes / 4; i++) {

                int k = addr + i * 4;

                mem[k] = (d[i] >> 24) & 0xff;
                mem[k+1] = (d[i] >> 16) & 0xff;
                mem[k+2] = (d[i] >> 8) & 0xff;
                mem[k+3] = d[i] & 0xff;

            }

        }

    $


    init $

        mem.resize(1024);

        for(int i = 0; i < 1024; i++)
            mem[i] = i & 0xff;

    $


    behavior

        do

            // Wait for request
            wait until(this_phase == 0);

            $
                hasToken =
                    inp.peek(requestFromCache);
            $;

            if(not hasToken) then
                wait
            end if;

            if(hasToken) then

                $
                    pulled =
                        inp.pull(requestFromCache);

                    sitar::unpack(
                        requestFromCache,
                        requestAddr,
                        requestType,
                        requestSize
                    );

                    responseData0 = 0;
                    responseData1 = 0;
                    responseData2 = 0;
                    responseData3 = 0;

                    responseErr = 0;

                    int bytes =
                        getSizeBytes(requestSize);


                    // Bounds check
                    if(requestAddr + bytes > 1024) {

                        responseErr = 1;

                        log << endl
                            << "Memory: OUT OF BOUNDS "
                            << "Addr="
                            << requestAddr;

                    }

                    // Alignment check
                    else if(!isAligned(
                        requestAddr,
                        requestSize
                    )) {

                        responseErr = 2;

                        log << endl
                            << "Memory: ALIGNMENT ERROR "
                            << "Addr="
                            << requestAddr;

                    }

                    else {

                        if(requestType == IFETCH) {

                            read_memory(
                                requestAddr,
                                requestSize
                            );

                        }

                        else if(requestType == LOAD) {

                            read_memory(
                                requestAddr,
                                requestSize
                            );

                        }

                        else if(requestType == STORE) {

                            // Memory receives write-back from cache
                            write_block(
                                requestAddr,
                                requestSize
                            );

                            log << endl
                                << "Memory: WRITE-BACK received "
                                << "addr=" << requestAddr
                                << " size=" << (int)requestSize;

                        }

                        else if(requestType == ATOMICLOADSTORE) {

                            read_memory(
                                requestAddr,
                                requestSize
                            );

                            write_word(
                                requestAddr,
                                0x11223344
                            );

                        }

                    }

                $;


                // Memory latency
                wait(MEMORY_DELAY, 0);


                // Send response
                $
                    sitar::pack(
                        responseToCache,
                        responseErr,
                        responseData0,
                        responseData1,
                        responseData2,
                        responseData3
                    );
                $;


                do

                    wait until(this_phase == 1);

                    $
                        ok =
                            outp.push(responseToCache);
                    $;

                    if(not ok) then
                        wait
                    end if;

                while(not ok) end do;

            end if;

        while(1) end do;

    end behavior

end module