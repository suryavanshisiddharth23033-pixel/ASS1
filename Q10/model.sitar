module Top
    submodule IM : Memory<>
    submodule DM : Memory<>
    submodule C : Core

    net c_im_request : capacity 1 width 22
    net im_c_response : capacity 1 width 17

    net c_dm_request : capacity 1 width 22
    net dm_c_response : capacity 1 width 17

    C.im_inp <= im_c_response
    IM.outp => im_c_response
    C.im_outp => c_im_request
    IM.inp <= c_im_request

    C.dm_inp <= dm_c_response
    DM.outp => dm_c_response
    C.dm_outp => c_dm_request
    DM.inp <= c_dm_request
end module


// Processor generates memory access patterns
procedure Processor

    parameter int P_LOAD = 40
    parameter int P_STORE = 30
    parameter int EXECUTION_DELAY = 3
    parameter int TOTAL_INSTRUCTIONS = 1000
    parameter int MAX_TIME = 100000
    parameter int BLOCK_SIZE = 16

    include $#include <cstdlib>$
    include $#include <cstdint>$

    decl $
        enum MemOpType {
            IFETCH = 0,
            LOAD = 1,
            STORE = 2,
            ATOMICLOADSTORE = 3
        };

        enum MemSize {
            WORD = 0,
            DOUBLEWORD = 1,
            QUADWORD = 2
        };

        int instr_count;

        uint32_t requestAddr;
        uint8_t requestType;
        uint8_t requestSize;

        uint8_t responseErr;
        uint32_t responseData0;
        uint32_t responseData1;
        uint32_t responseData2;
        uint32_t responseData3;

        bool hasToken;
        bool keepRunning;

        bool do_load;
        bool do_store;

        int pLoad;
        int pStore;

        double TEMPORAL_LOCALITY;
        double SPATIAL_LOCALITY;

        static const uint32_t ADDR_SPACE = 1024;
        static const int HISTORY_SIZE = 8;

        uint32_t addrHistory[HISTORY_SIZE];

        int histCount;
        int histPos;

        uint32_t prevAddr;
        bool havePrev;

        // ICACHE interface pointers
        bool *ic_req_valid;
        bool *ic_resp_valid;

        uint32_t *ic_req_addr;
        uint8_t *ic_req_type;
        uint8_t *ic_req_size;

        uint8_t *ic_resp_err;

        uint32_t *ic_resp_data0;
        uint32_t *ic_resp_data1;
        uint32_t *ic_resp_data2;
        uint32_t *ic_resp_data3;

        // DCACHE interface pointers
        bool *dc_req_valid;
        bool *dc_resp_valid;

        uint32_t *dc_req_addr;
        uint8_t *dc_req_type;
        uint8_t *dc_req_size;

        uint8_t *dc_resp_err;

        uint32_t *dc_resp_data0;
        uint32_t *dc_resp_data1;
        uint32_t *dc_resp_data2;
        uint32_t *dc_resp_data3;


        double frand01() {
            return (rand() % 1000000) / 1000000.0;
        }


        uint32_t genAddress() {

            uint32_t addr;

            if(havePrev && frand01() < SPATIAL_LOCALITY) {

                uint32_t blockStart =
                    prevAddr & ~((uint32_t)BLOCK_SIZE - 1);

                addr = blockStart +
                    4 * (uint32_t)(rand() % (BLOCK_SIZE / 4));

            }
            else if(histCount > 0 &&
                    frand01() < TEMPORAL_LOCALITY) {

                addr = addrHistory[rand() % histCount];

            }
            else {

                addr = 4 * (uint32_t)(rand() % (ADDR_SPACE / 4));

            }

            addrHistory[histPos] = addr;

            histPos = (histPos + 1) % HISTORY_SIZE;

            if(histCount < HISTORY_SIZE)
                histCount++;

            prevAddr = addr;
            havePrev = true;

            return addr;
        }


        int getSizeBytes(int size) {

            if(size == WORD) return 4;
            if(size == DOUBLEWORD) return 8;

            return 16;
        }


        uint32_t alignAddr(uint32_t addr, int size) {

            if(size == WORD)
                return addr & ~3u;

            if(size == DOUBLEWORD)
                return addr & ~7u;

            return addr & ~15u;
        }


        void sendICacheRequest(
            uint32_t addr,
            uint8_t type,
            uint8_t size
        ) {

            *ic_req_addr = addr;
            *ic_req_type = type;
            *ic_req_size = size;

            *ic_resp_valid = false;

            *ic_req_valid = true;
        }


        void sendDCacheRequest(
            uint32_t addr,
            uint8_t type,
            uint8_t size
        ) {

            *dc_req_addr = addr;
            *dc_req_type = type;
            *dc_req_size = size;

            *dc_resp_valid = false;

            *dc_req_valid = true;
        }


        void printData(int size) {

            int bytes = getSizeBytes(size);

            uint32_t d[4] = {
                responseData0,
                responseData1,
                responseData2,
                responseData3
            };

            log << " data=";

            for(int i = 0; i < bytes / 4; i++) {

                log
                    << ((d[i] >> 24) & 0xff) << " "
                    << ((d[i] >> 16) & 0xff) << " "
                    << ((d[i] >> 8) & 0xff) << " "
                    << (d[i] & 0xff) << " ";

            }
        }

    $


    init $

        instr_count = 0;

        histCount = 0;
        histPos = 0;

        prevAddr = 0;
        havePrev = false;

        pLoad = P_LOAD;
        pStore = P_STORE;

        TEMPORAL_LOCALITY = 0.7;
        SPATIAL_LOCALITY = 0.6;

        if(const char* e = std::getenv("TEMPORAL_LOCALITY"))
            TEMPORAL_LOCALITY = std::atof(e);

        if(const char* e = std::getenv("SPATIAL_LOCALITY"))
            SPATIAL_LOCALITY = std::atof(e);

        if(const char* e = std::getenv("P_LOAD"))
            pLoad = std::atoi(e);

        if(const char* e = std::getenv("P_STORE"))
            pStore = std::atoi(e);

    $


    behavior

        do

            // Instruction fetch from icache
            $

                if(instr_count == 0) {

                    log << endl
                        << "LOCALITY temporal="
                        << TEMPORAL_LOCALITY
                        << " spatial="
                        << SPATIAL_LOCALITY
                        << " p_load="
                        << pLoad
                        << " p_store="
                        << pStore;

                }

                requestType = IFETCH;
                requestSize = WORD;

                requestAddr =
                    alignAddr(genAddress(), WORD);

                log << endl
                    << "IFETCH addr="
                    << requestAddr;

                sendICacheRequest(
                    requestAddr,
                    requestType,
                    requestSize
                );
            $;


            // Wait for icache response
            do

                $
                    hasToken = *ic_resp_valid;
                $;

                if(not hasToken) then
                    wait
                end if;

            while(not hasToken) end do;


            // Consume icache response
            $
                responseErr = *ic_resp_err;

                responseData0 = *ic_resp_data0;
                responseData1 = *ic_resp_data1;
                responseData2 = *ic_resp_data2;
                responseData3 = *ic_resp_data3;

                *ic_resp_valid = false;

                if(responseErr != 0) {

                    log << endl
                        << "IFETCH ERROR="
                        << (int)responseErr;

                }
                else {

                    log << endl << "IFETCH OK";

                    printData(WORD);

                }
            $;


            // Execution delay
            wait(EXECUTION_DELAY, 0);

            $
                do_load =
                    (rand() % 100) < pLoad;

                do_store =
                    (rand() % 100) < pStore;
            $;


            // LOAD operation (only when a store is NOT also requested)
            if(do_load and not do_store) then

                $
                    requestType = LOAD;

                    requestSize = rand() % 3;

                    requestAddr =
                        alignAddr(
                            genAddress(),
                            requestSize
                        );

                    log << endl
                        << "LOAD addr="
                        << requestAddr
                        << " size="
                        << (int)requestSize;

                    sendDCacheRequest(
                        requestAddr,
                        requestType,
                        requestSize
                    );
                $;


                do

                    $
                        hasToken = *dc_resp_valid;
                    $;

                    if(not hasToken) then
                        wait
                    end if;

                while(not hasToken) end do;

                $
                    responseErr = *dc_resp_err;

                    responseData0 = *dc_resp_data0;
                    responseData1 = *dc_resp_data1;
                    responseData2 = *dc_resp_data2;
                    responseData3 = *dc_resp_data3;

                    *dc_resp_valid = false;

                    if(responseErr != 0) {

                        log << endl
                            << "LOAD ERROR="
                            << (int)responseErr;

                    }
                    else {

                        log << endl << "LOAD OK";

                        printData(requestSize);

                    }
                $;

            end if;


            // STORE operation (only when a load is NOT also requested)
            if(do_store and not do_load) then

                $
                    requestType = STORE;

                    requestSize = rand() % 3;

                    requestAddr =
                        alignAddr(
                            genAddress(),
                            requestSize
                        );

                    log << endl
                        << "STORE addr="
                        << requestAddr
                        << " size="
                        << (int)requestSize;

                    sendDCacheRequest(
                        requestAddr,
                        requestType,
                        requestSize
                    );
                $;


                do

                    $
                        hasToken = *dc_resp_valid;
                    $;

                    if(not hasToken) then
                        wait
                    end if;

                while(not hasToken) end do;

                $
                    responseErr = *dc_resp_err;

                    responseData0 = *dc_resp_data0;
                    responseData1 = *dc_resp_data1;
                    responseData2 = *dc_resp_data2;
                    responseData3 = *dc_resp_data3;

                    *dc_resp_valid = false;

                    if(responseErr != 0) {

                        log << endl
                            << "STORE ERROR="
                            << (int)responseErr;

                    }
                    else {

                        log << endl << "STORE OK";

                    }
                $;

            end if;


            // ATOMIC operation (both load and store requested)
            if(do_load and do_store) then

                $
                    requestType = ATOMICLOADSTORE;

                    requestSize = WORD;

                    requestAddr =
                        alignAddr(
                            genAddress(),
                            requestSize
                        );

                    log << endl
                        << "ATOMIC addr="
                        << requestAddr
                        << " size="
                        << (int)requestSize;

                    sendDCacheRequest(
                        requestAddr,
                        requestType,
                        requestSize
                    );
                $;


                do

                    $
                        hasToken = *dc_resp_valid;
                    $;

                    if(not hasToken) then
                        wait
                    end if;

                while(not hasToken) end do;

                $
                    responseErr = *dc_resp_err;

                    responseData0 = *dc_resp_data0;
                    responseData1 = *dc_resp_data1;
                    responseData2 = *dc_resp_data2;
                    responseData3 = *dc_resp_data3;

                    *dc_resp_valid = false;

                    if(responseErr != 0) {

                        log << endl
                            << "ATOMIC ERROR="
                            << (int)responseErr;

                    }
                    else {

                        log << endl << "ATOMIC OK";

                        printData(WORD);

                    }
                $;

            end if;


            // Instruction complete
            $
                instr_count++;

                log << endl
                    << "INSTRUCTION "
                    << instr_count
                    << " COMPLETE";

                keepRunning =
                    (instr_count < TOTAL_INSTRUCTIONS) &&
                    (current_time.cycle() < MAX_TIME);
            $;

        while(keepRunning) end do;


        // Request icache statistics
        $
            sendICacheRequest(
                0xFFFFFFFF,
                IFETCH,
                WORD
            );
        $;

        do

            $
                hasToken = *ic_resp_valid;
            $;

            if(not hasToken) then
                wait
            end if;

        while(not hasToken) end do;

        $
            *ic_resp_valid = false;
        $;


        // Request dcache statistics
        $
            sendDCacheRequest(
                0xFFFFFFFF,
                IFETCH,
                WORD
            );
        $;

        do

            $
                hasToken = *dc_resp_valid;
            $;

            if(not hasToken) then
                wait
            end if;

        while(not hasToken) end do;

        $
            *dc_resp_valid = false;

            if(instr_count >= TOTAL_INSTRUCTIONS) {

                log << endl
                    << "Completed "
                    << TOTAL_INSTRUCTIONS
                    << " instructions";

            }
            else {

                log << endl
                    << "TIME LIMIT EXCEEDED at cycle "
                    << current_time.cycle();

            }

            log << endl
                << "RESULT instructions="
                << instr_count
                << " cycles="
                << current_time.cycle();
        $;

        stop simulation;

    end behavior

end procedure



// =====================================================================
// Non-blocking write-back set-associative cache (processor-facing part)
// NUM_SETS: number of sets, NUM_WAYS: associativity,
// BLOCK_SIZE: bytes per block.
// The write-back to memory is performed by the WbEngine procedure,
// which shares the state declared in the section marked WRITE-BACK
// BUFFER below.
// =====================================================================
procedure Cache

    parameter int NUM_SETS = 4
    parameter int NUM_WAYS = 4
    parameter int BLOCK_SIZE = 16
    parameter int CACHE_DELAY = 4

    include $#include <cstdlib>$
    include $#include <vector>$
    include $#include <cstdint>$
    include $#include <cmath>$

    decl $

        enum MemOpType {
            IFETCH = 0,
            LOAD = 1,
            STORE = 2,
            ATOMICLOADSTORE = 3
        };

        enum MemSize {
            WORD = 0,
            DOUBLEWORD = 1,
            QUADWORD = 2
        };

        enum CacheStatus {
            MISS = -1,
            HIT = 1
        };


        class CacheLine {

            public:

                bool validBit;
                bool dirtyBit;
                uint32_t tagBit;
                std::vector<uint8_t> data;

                CacheLine() {
                    validBit = false;
                    dirtyBit = false;
                    tagBit = 0;
                    data.resize(BLOCK_SIZE, 0);
                }
        };


        // cache[set][way]
        std::vector<std::vector<CacheLine>> cache;


        // Processor interface (shared variables)
        bool req_valid;
        bool resp_valid;

        uint32_t req_addr;
        uint8_t req_type;
        uint8_t req_size;

        uint8_t resp_err;

        uint32_t resp_data0;
        uint32_t resp_data1;
        uint32_t resp_data2;
        uint32_t resp_data3;


        // Memory interface
        token<22> requestToMemory;
        token<17> responseFromMemory;

        uint32_t requestAddr;
        uint8_t requestType;
        uint8_t requestSize;

        uint8_t responseErr;

        uint32_t responseData0;
        uint32_t responseData1;
        uint32_t responseData2;
        uint32_t responseData3;


        int cacheStatus;
        bool hasToken;
        bool ok;
        bool pulled;
        bool isStatRequest;


        // ---------------- WRITE-BACK BUFFER (shared with WbEngine) ----------------
        // wbPending : a dirty victim is parked in the buffer and has not
        //             yet been acknowledged by memory.
        // wbBlockAddr/wbData0..3 : block address and contents of that victim.
        // memBusy   : mutex for the single memory port.
        // feWaiting : the cache front end wants the memory port. The engine
        //             never starts a write-back while this is set, so
        //             demand fetches have priority over write-back.
        bool wbPending;
        uint32_t wbBlockAddr;
        uint32_t wbData0;
        uint32_t wbData1;
        uint32_t wbData2;
        uint32_t wbData3;
        bool memBusy;
        bool feWaiting;
        long statWbDone;

        // Experiment switch: 1 = non-blocking, 0 = blocking (Q9-like)
        int nonBlocking;

        // Front-end temporaries (must live in decl to be visible in all blocks)
        uint32_t wb_setIdx;
        int wb_victimWay;
        bool wb_needWriteback;
        uint32_t wb_victimAddr;
        uint32_t missBlockAddr;
        bool conflict;
        bool bufBusy;
        bool gotMem;
        bool stallLogged;

        // Statistics
        long statTotal;
        long statHits;
        long statMisses;
        long statWritebacks;
        long statHitsUnderWB;
        long statConflictStall;
        long statBufferStall;
        long statMemWait;


        int getSizeBytes(int size) {

            if(size == WORD) return 4;
            if(size == DOUBLEWORD) return 8;

            return 16;
        }


        bool isAligned(uint32_t addr, int size) {

            if(size == WORD)
                return (addr & 3) == 0;

            if(size == DOUBLEWORD)
                return (addr & 7) == 0;

            return (addr & 15) == 0;
        }


        // TAG = address / (BLOCK_SIZE * NUM_SETS)
        uint32_t get_tag(uint32_t addr) {

            return addr / (BLOCK_SIZE * NUM_SETS);

        }


        // SET = (address / BLOCK_SIZE) % NUM_SETS
        uint32_t get_set_index(uint32_t addr) {

            return (addr / BLOCK_SIZE) % NUM_SETS;

        }


        uint32_t get_offset(uint32_t addr) {

            return addr % BLOCK_SIZE;

        }


        int find_way(uint32_t tag, uint32_t setIdx) {

            for(int way = 0; way < NUM_WAYS; way++) {
                if(cache[setIdx][way].validBit &&
                   cache[setIdx][way].tagBit == tag) {
                    return way;
                }
            }
            return -1;
        }


        // Read from set-associative cache (fills responseData0..3 on HIT)
        int read_cache(uint32_t addr, int size) {

            responseData0 = 0;
            responseData1 = 0;
            responseData2 = 0;
            responseData3 = 0;

            uint32_t tag = get_tag(addr);
            uint32_t setIdx = get_set_index(addr);
            uint32_t offset = get_offset(addr);

            int bytes = getSizeBytes(size);

            if(offset + bytes > BLOCK_SIZE)
                return MISS;


            for(int way = 0; way < NUM_WAYS; way++) {

                if(cache[setIdx][way].validBit &&
                   cache[setIdx][way].tagBit == tag) {

                    uint32_t d[4] = {0, 0, 0, 0};

                    for(int j = 0; j < bytes / 4; j++) {

                        int k = offset + j * 4;

                        d[j] =
                            ((uint32_t)cache[setIdx][way].data[k] << 24) |
                            ((uint32_t)cache[setIdx][way].data[k+1] << 16) |
                            ((uint32_t)cache[setIdx][way].data[k+2] << 8) |
                            ((uint32_t)cache[setIdx][way].data[k+3]);

                    }

                    responseData0 = d[0];
                    responseData1 = d[1];
                    responseData2 = d[2];
                    responseData3 = d[3];

                    return HIT;

                }
            }

            return MISS;
        }


        // Simulated processor write data for a STORE
        void set_store_data() {

            responseData0 = 0xAABBCCDD;
            responseData1 = 0xAABBCCDD;
            responseData2 = 0xAABBCCDD;
            responseData3 = 0xAABBCCDD;

        }


        // Write responseData into the block at the request offset; DIRTY = 1
        void write_data_to_cache(uint32_t addr, int size) {

            uint32_t setIdx = get_set_index(addr);
            uint32_t offset = get_offset(addr);

            int bytes = getSizeBytes(size);

            uint32_t d[4] = {
                responseData0,
                responseData1,
                responseData2,
                responseData3
            };

            int way = find_way(get_tag(addr), setIdx);
            if(way < 0) return;

            for(int i = 0; i < bytes / 4; i++) {

                int k = offset + i * 4;

                cache[setIdx][way].data[k] =
                    (d[i] >> 24) & 0xff;
                cache[setIdx][way].data[k+1] =
                    (d[i] >> 16) & 0xff;
                cache[setIdx][way].data[k+2] =
                    (d[i] >> 8) & 0xff;
                cache[setIdx][way].data[k+3] =
                    d[i] & 0xff;

            }

            cache[setIdx][way].dirtyBit = true;

        }


        // Copy a whole block into responseData0..3
        void read_block_for_writeback(uint32_t setIdx, int way) {

            uint32_t d[4] = {0, 0, 0, 0};

            for(int i = 0; i < BLOCK_SIZE / 4; i++) {

                int k = i * 4;

                d[i] =
                    ((uint32_t)cache[setIdx][way].data[k] << 24) |
                    ((uint32_t)cache[setIdx][way].data[k+1] << 16) |
                    ((uint32_t)cache[setIdx][way].data[k+2] << 8) |
                    ((uint32_t)cache[setIdx][way].data[k+3]);

            }

            responseData0 = d[0];
            responseData1 = d[1];
            responseData2 = d[2];
            responseData3 = d[3];

        }


        uint32_t get_block_addr_from_tag_set(uint32_t tag, uint32_t setIdx) {

            return (tag * NUM_SETS + setIdx) * BLOCK_SIZE;

        }


        int select_victim_way(uint32_t setIdx) {

            for(int way = 0; way < NUM_WAYS; way++) {
                if(!cache[setIdx][way].validBit) {
                    return way;
                }
            }

            return rand() % NUM_WAYS;

        }


        // Install the fetched block (in responseData0..3) into replaceWay
        void write_cache(uint32_t addr, int replaceWay) {

            uint32_t tag = get_tag(addr);
            uint32_t setIdx = get_set_index(addr);

            uint32_t d[4] = {
                responseData0,
                responseData1,
                responseData2,
                responseData3
            };

            for(int i = 0; i < BLOCK_SIZE; i++) {

                int word = i / 4;
                int byte = i % 4;

                cache[setIdx][replaceWay].data[i] =
                    (d[word] >> (24 - byte * 8)) & 0xff;

            }

            cache[setIdx][replaceWay].tagBit = tag;
            cache[setIdx][replaceWay].validBit = true;
            cache[setIdx][replaceWay].dirtyBit = false;

        }


        // Request token: address, type, size, then four data words
        // (data words are only meaningful for STORE requests)
        void prepareMemoryRequest(
            uint32_t addr,
            uint8_t type,
            uint8_t size,
            uint32_t d0,
            uint32_t d1,
            uint32_t d2,
            uint32_t d3
        ) {

            sitar::pack(
                requestToMemory,
                addr,
                type,
                size,
                d0,
                d1,
                d2,
                d3
            );

        }


        // Pointers to Core's memory ports
        inport<17>* m_inp;
        outport<22>* m_outp;
    $

    init $

        cache.resize(NUM_SETS);
        for(int i = 0; i < NUM_SETS; i++) {
            cache[i].resize(NUM_WAYS);
        }

        req_valid = false;
        resp_valid = false;

        req_addr = 0;
        req_type = 0;
        req_size = 0;

        resp_err = 0;

        resp_data0 = 0;
        resp_data1 = 0;
        resp_data2 = 0;
        resp_data3 = 0;

        wbPending = false;
        wbBlockAddr = 0;
        wbData0 = 0;
        wbData1 = 0;
        wbData2 = 0;
        wbData3 = 0;
        memBusy = false;
        feWaiting = false;
        statWbDone = 0;

        nonBlocking = 1;

        if(const char* e = std::getenv("NON_BLOCKING"))
            nonBlocking = std::atoi(e);

        statTotal = 0;
        statHits = 0;
        statMisses = 0;
        statWritebacks = 0;
        statHitsUnderWB = 0;
        statConflictStall = 0;
        statBufferStall = 0;
        statMemWait = 0;

    $


    behavior

        do

            // Wait for processor request
            do

                $
                    hasToken = req_valid;
                $;

                if(not hasToken) then
                    wait
                end if;

            while(not hasToken) end do;


            // Accept request from processor
            $
                requestAddr = req_addr;
                requestType = req_type;
                requestSize = req_size;

                req_valid = false;

                responseErr = 0;

                responseData0 = 0;
                responseData1 = 0;
                responseData2 = 0;
                responseData3 = 0;

                isStatRequest =
                    (requestAddr == 0xFFFFFFFF);

            $;


            // Statistics request
            if(isStatRequest) then

                $
                    log << endl
                        << "CACHE STATISTICS"
                        << " (config: sets="
                        << NUM_SETS
                        << " ways="
                        << NUM_WAYS
                        << " blockSize="
                        << BLOCK_SIZE
                        << " nonBlocking="
                        << nonBlocking << ")";

                    log << endl
                        << "requests="
                        << statTotal
                        << " hits="
                        << statHits
                        << " misses="
                        << statMisses
                        << " writebacks="
                        << statWritebacks
                        << " writebacks_done="
                        << statWbDone;

                    log << endl
                        << "hits_under_wb="
                        << statHitsUnderWB
                        << " conflict_stall_cycles="
                        << statConflictStall
                        << " buffer_stall_cycles="
                        << statBufferStall
                        << " mem_wait_cycles="
                        << statMemWait;

                    log << endl
                        << "p_hit="
                        << (
                            statTotal > 0
                            ? (double)statHits / statTotal
                            : 0.0
                        );

                    log << endl
                        << "p_writeback_per_miss="
                        << (
                            statMisses > 0
                            ? (double)statWritebacks / statMisses
                            : 0.0
                        );
                $;

            else

                if(not isAligned(requestAddr, requestSize)) then

                    $
                        responseErr = 2;

                        log << endl
                            << "CACHE ALIGNMENT ERROR "
                            << requestAddr;
                    $;

                else

                    if(requestType == ATOMICLOADSTORE) then

                        // Atomics bypass the cache (write-through) but must
                        // respect the memory port and the block in the buffer.
                        $
                            statTotal++;
                            statMisses++;

                            missBlockAddr =
                                requestAddr & ~((uint32_t)BLOCK_SIZE - 1);

                            stallLogged = false;

                            prepareMemoryRequest(
                                requestAddr,
                                requestType,
                                requestSize,
                                0, 0, 0, 0
                            );

                            log << endl
                                << "CACHE ATOMIC WRITE-THROUGH";
                        $;


                        do

                            $
                                conflict =
                                    wbPending &&
                                    (wbBlockAddr == missBlockAddr);

                                if(conflict) {
                                    statConflictStall++;
                                }
                            $;

                            if(conflict) then
                                wait
                            end if;

                        while(conflict) end do;


                        $
                            feWaiting = true;
                        $;

                        do

                            $
                                if(!memBusy) {
                                    memBusy = true;
                                    feWaiting = false;
                                    gotMem = true;
                                }
                                else {
                                    gotMem = false;
                                    statMemWait++;
                                }
                            $;

                            if(not gotMem) then
                                wait
                            end if;

                        while(not gotMem) end do;


                        do

                            wait until(this_phase == 1);

                            $
                                ok = m_outp->push(requestToMemory);
                            $;

                            if(not ok) then
                                wait
                            end if;

                        while(not ok) end do;


                        do

                            wait until(this_phase == 0);

                            $
                                hasToken =
                                    m_inp->peek(responseFromMemory);
                            $;

                            if(not hasToken) then
                                wait
                            end if;

                        while(not hasToken) end do;

                        $
                            pulled =
                                m_inp->pull(responseFromMemory);

                            sitar::unpack(
                                responseFromMemory,
                                responseErr,
                                responseData0,
                                responseData1,
                                responseData2,
                                responseData3
                            );

                            memBusy = false;
                        $;

                    else

                        // IFETCH / LOAD / STORE
                        $
                            cacheStatus =
                                read_cache(
                                    requestAddr,
                                    requestSize
                                );
                        $;


                        if(cacheStatus == HIT) then

                            // HIT: served immediately, whether or not a
                            // write-back is in progress. The block under
                            // write-back is not in the cache (its line was
                            // invalidated when it was parked), so a hit can
                            // never touch it.
                            $
                                statTotal++;
                                statHits++;

                                if(requestType == STORE) {

                                    set_store_data();

                                    write_data_to_cache(
                                        requestAddr,
                                        requestSize
                                    );

                                }

                                if(wbPending) {

                                    statHitsUnderWB++;

                                    log << endl
                                        << "HIT UNDER WRITE-BACK type="
                                        << (int)requestType
                                        << " addr="
                                        << requestAddr
                                        << " wbBlock="
                                        << wbBlockAddr
                                        << " cycle="
                                        << current_time.cycle();

                                }
                                else {

                                    log << endl << "Cache HIT";

                                }
                            $;

                        else

                            // MISS
                            $
                                statTotal++;
                                statMisses++;

                                missBlockAddr =
                                    requestAddr & ~((uint32_t)BLOCK_SIZE - 1);

                                stallLogged = false;

                                log << endl
                                    << "Cache MISS type="
                                    << (int)requestType
                                    << " addr="
                                    << requestAddr
                                    << " wbPending="
                                    << wbPending
                                    << " cycle="
                                    << current_time.cycle();
                            $;


                            // (A) Stall while the very block we need is still
                            //     being written back: fetching it now would
                            //     return stale data from memory.
                            do

                                $
                                    conflict =
                                        wbPending &&
                                        (wbBlockAddr == missBlockAddr);

                                    if(conflict) {

                                        statConflictStall++;

                                        if(!stallLogged) {

                                            stallLogged = true;

                                            log << endl
                                                << "STALL miss on block under write-back block="
                                                << missBlockAddr
                                                << " cycle="
                                                << current_time.cycle();

                                        }
                                    }
                                $;

                                if(conflict) then
                                    wait
                                end if;

                            while(conflict) end do;


                            // (B) Choose the victim
                            $
                                wb_setIdx = get_set_index(requestAddr);
                                wb_victimWay = select_victim_way(wb_setIdx);

                                wb_needWriteback =
                                    cache[wb_setIdx][wb_victimWay].validBit &&
                                    cache[wb_setIdx][wb_victimWay].dirtyBit;

                                wb_victimAddr = 0;

                                if(wb_needWriteback) {
                                    wb_victimAddr =
                                        get_block_addr_from_tag_set(
                                            cache[wb_setIdx][wb_victimWay].tagBit,
                                            wb_setIdx
                                        );
                                }
                            $;


                            // (C) Dirty victim: park it in the write-back buffer
                            if(wb_needWriteback) then

                                // Only one write-back at a time: wait for the
                                // buffer to be free.
                                do

                                    $
                                        bufBusy = wbPending;

                                        if(bufBusy) {
                                            statBufferStall++;
                                        }
                                    $;

                                    if(bufBusy) then
                                        wait
                                    end if;

                                while(bufBusy) end do;


                                $
                                    statWritebacks++;

                                    read_block_for_writeback(
                                        wb_setIdx,
                                        wb_victimWay
                                    );

                                    wbData0 = responseData0;
                                    wbData1 = responseData1;
                                    wbData2 = responseData2;
                                    wbData3 = responseData3;

                                    wbBlockAddr = wb_victimAddr;
                                    wbPending = true;

                                    // The line is free for reuse right now.
                                    cache[wb_setIdx][wb_victimWay].validBit = false;
                                    cache[wb_setIdx][wb_victimWay].dirtyBit = false;

                                    log << endl
                                        << "WRITE-BACK PARKED victim="
                                        << wb_victimAddr
                                        << " cycle="
                                        << current_time.cycle();
                                $;


                                // Blocking mode (Q9 behaviour): do not go on
                                // until the write-back has finished.
                                if(nonBlocking == 0) then

                                    do

                                        $
                                            bufBusy = wbPending;
                                        $;

                                        if(bufBusy) then
                                            wait
                                        end if;

                                    while(bufBusy) end do;

                                end if;

                            end if;


                            // (D) Acquire the memory port. Setting feWaiting
                            //     keeps the engine from starting a new
                            //     write-back first (reads have priority).
                            $
                                feWaiting = true;
                            $;

                            do

                                $
                                    if(!memBusy) {
                                        memBusy = true;
                                        feWaiting = false;
                                        gotMem = true;
                                    }
                                    else {
                                        gotMem = false;
                                        statMemWait++;
                                    }
                                $;

                                if(not gotMem) then
                                    wait
                                end if;

                            while(not gotMem) end do;


                            // (E) Fetch the requested block
                            $
                                uint32_t blockAddr =
                                    requestAddr & ~((uint32_t)BLOCK_SIZE - 1);

                                uint8_t blockSize;

                                if(BLOCK_SIZE == 4)
                                    blockSize = WORD;
                                else if(BLOCK_SIZE == 8)
                                    blockSize = DOUBLEWORD;
                                else
                                    blockSize = QUADWORD;

                                prepareMemoryRequest(
                                    blockAddr,
                                    LOAD,
                                    blockSize,
                                    0, 0, 0, 0
                                );

                                log << endl
                                    << "FETCH block="
                                    << blockAddr
                                    << " cycle="
                                    << current_time.cycle();
                            $;


                            do

                                wait until(this_phase == 1);

                                $
                                    ok = m_outp->push(requestToMemory);
                                $;

                                if(not ok) then
                                    wait
                                end if;

                            while(not ok) end do;


                            do

                                wait until(this_phase == 0);

                                $
                                    hasToken =
                                        m_inp->peek(responseFromMemory);
                                $;

                                if(not hasToken) then
                                    wait
                                end if;

                            while(not hasToken) end do;

                            $
                                pulled =
                                    m_inp->pull(responseFromMemory);

                                sitar::unpack(
                                    responseFromMemory,
                                    responseErr,
                                    responseData0,
                                    responseData1,
                                    responseData2,
                                    responseData3
                                );

                                // Release the port: the engine may now drain
                                // the write-back buffer in the background.
                                memBusy = false;
                            $;


                            // (F) Install the block and complete the access
                            $
                                if(responseErr == 0) {

                                    write_cache(requestAddr, wb_victimWay);

                                    if(requestType == STORE) {

                                        set_store_data();

                                        write_data_to_cache(
                                            requestAddr,
                                            requestSize
                                        );

                                        log << endl
                                            << "STORE to new block dirty=1";

                                    }
                                    else {

                                        read_cache(
                                            requestAddr,
                                            requestSize
                                        );

                                    }
                                }
                            $;

                        end if;     // closes: cacheStatus == HIT

                    end if;         // closes: ATOMICLOADSTORE

                end if;             // closes: alignment check

            end if;                 // closes: isStatRequest


            // Cache access delay
            wait(CACHE_DELAY, 0);


            // Send response to processor
            $
                resp_err = responseErr;

                resp_data0 = responseData0;
                resp_data1 = responseData1;
                resp_data2 = responseData2;
                resp_data3 = responseData3;

                resp_valid = true;
            $;


            // Wait for processor to consume response
            do

                $
                    hasToken = resp_valid;
                $;

                if(hasToken) then
                    wait
                end if;

            while(hasToken) end do;

        while(1) end do;

    end behavior

end procedure



// =====================================================================
// Write-back engine: drains the write-back buffer of one Cache to memory
// in the background. It only touches the buffer and the memory port; it
// never reads or writes cache lines, so it cannot race with the front end.
// =====================================================================
procedure WbEngine

    parameter int BLOCK_SIZE = 16

    include $#include <cstdlib>$
    include $#include <cstdint>$

    decl $

        enum MemOpType {
            IFETCH = 0,
            LOAD = 1,
            STORE = 2,
            ATOMICLOADSTORE = 3
        };

        enum MemSize {
            WORD = 0,
            DOUBLEWORD = 1,
            QUADWORD = 2
        };

        // Wired to the cache by Core
        bool *wb_pending;
        bool *mem_busy;
        bool *fe_waiting;
        uint32_t *wb_block_addr;
        uint32_t *wb_d0;
        uint32_t *wb_d1;
        uint32_t *wb_d2;
        uint32_t *wb_d3;
        long *wb_done_cnt;

        token<22> requestToMemory;
        token<17> responseFromMemory;

        uint8_t responseErr;
        uint32_t responseData0;
        uint32_t responseData1;
        uint32_t responseData2;
        uint32_t responseData3;

        bool hasWork;
        bool ok;
        bool hasToken;
        bool pulled;


        void prepareWriteback() {

            uint32_t addr = *wb_block_addr;
            uint8_t type = STORE;
            uint8_t size;

            if(BLOCK_SIZE == 4)
                size = WORD;
            else if(BLOCK_SIZE == 8)
                size = DOUBLEWORD;
            else
                size = QUADWORD;

            uint32_t d0 = *wb_d0;
            uint32_t d1 = *wb_d1;
            uint32_t d2 = *wb_d2;
            uint32_t d3 = *wb_d3;

            sitar::pack(
                requestToMemory,
                addr,
                type,
                size,
                d0,
                d1,
                d2,
                d3
            );

        }


        inport<17>* m_inp;
        outport<22>* m_outp;
    $

    init $
    $


    behavior

        do

            // Wait until there is something to write back AND the memory
            // port is free AND the cache front end is not asking for it.
            // The test and the claim are one code block, so they are atomic.
            do

                $
                    hasWork =
                        (*wb_pending) &&
                        (!(*fe_waiting)) &&
                        (!(*mem_busy));

                    if(hasWork) {
                        *mem_busy = true;
                    }
                $;

                if(not hasWork) then
                    wait
                end if;

            while(not hasWork) end do;


            $
                prepareWriteback();

                log << endl
                    << "WRITE-BACK START block="
                    << *wb_block_addr
                    << " cycle="
                    << current_time.cycle();
            $;


            do

                wait until(this_phase == 1);

                $
                    ok = m_outp->push(requestToMemory);
                $;

                if(not ok) then
                    wait
                end if;

            while(not ok) end do;


            do

                wait until(this_phase == 0);

                $
                    hasToken =
                        m_inp->peek(responseFromMemory);
                $;

                if(not hasToken) then
                    wait
                end if;

            while(not hasToken) end do;


            $
                pulled =
                    m_inp->pull(responseFromMemory);

                sitar::unpack(
                    responseFromMemory,
                    responseErr,
                    responseData0,
                    responseData1,
                    responseData2,
                    responseData3
                );

                if(responseErr != 0) {

                    log << endl
                        << "WRITE-BACK ERROR="
                        << (int)responseErr;

                }

                log << endl
                    << "WRITE-BACK DONE block="
                    << *wb_block_addr
                    << " cycle="
                    << current_time.cycle();

                (*wb_done_cnt)++;
                *wb_pending = false;
                *mem_busy = false;
            $;

        while(1) end do;

    end behavior

end procedure



// Core module: Processor + ICACHE + DCACHE (+ one write-back engine each)
module Core

    procedure proc : Processor<40, 3 total (256 bytes)
    procedure icache : Cache<4, 4, 16>

    // DCACHE: 2 sets, 8 ways = 16 blocks total (256 bytes)
    procedure dcache : Cache<2, 8, 16>

    procedure icache_wb : WbEngine<16>
    procedure dcache_wb : WbEngine<16>


    // Instruction memory ports
    inport im_inp : width 17
    outport im_outp : width 22


    // Data memory ports
    inport dm_inp : width 17
    outport dm_outp : width 22

    decl $
    $


    init $

        // Caches and engines share the memory ports
        icache.m_inp = &im_inp;
        icache.m_outp = &im_outp;
        icache_wb.m_inp = &im_inp;
        icache_wb.m_outp = &im_outp;

        dcache.m_inp = &dm_inp;
        dcache.m_outp = &dm_outp;
        dcache_wb.m_inp = &dm_inp;
        dcache_wb.m_outp = &dm_outp;

        // ICACHE <-> its write-back engine
        icache_wb.wb_pending = &icache.wbPending;
        icache_wb.mem_busy = &icache.memBusy;
        icache_wb.fe_waiting = &icache.feWaiting;
        icache_wb.wb_block_addr = &icache.wbBlockAddr;
        icache_wb.wb_d0 = &icache.wbData0;
        icache_wb.wb_d1 = &icache.wbData1;
        icache_wb.wb_d2 = &icache.wbData2;
        icache_wb.wb_d3 = &icache.wbData3;
        icache_wb.wb_done_cnt = &icache.statWbDone;

        // DCACHE <-> its write-back engine
        dcache_wb.wb_pending = &dcache.wbPending;
        dcache_wb.mem_busy = &dcache.memBusy;
        dcache_wb.fe_waiting = &dcache.feWaiting;
        dcache_wb.wb_block_addr = &dcache.wbBlockAddr;
        dcache_wb.wb_d0 = &dcache.wbData0;
        dcache_wb.wb_d1 = &dcache.wbData1;
        dcache_wb.wb_d2 = &dcache.wbData2;
        dcache_wb.wb_d3 = &dcache.wbData3;
        dcache_wb.wb_done_cnt = &dcache.statWbDone;

        // Processor <-> ICACHE
        proc.ic_req_valid = &icache.req_valid;
        proc.ic_resp_valid = &icache.resp_valid;

        proc.ic_req_addr = &icache.req_addr;
        proc.ic_req_type = &icache.req_type;
        proc.ic_req_size = &icache.req_size;

        proc.ic_resp_err = &icache.resp_err;

        proc.ic_resp_data0 = &icache.resp_data0;
        proc.ic_resp_data1 = &icache.resp_data1;
        proc.ic_resp_data2 = &icache.resp_data2;
        proc.ic_resp_data3 = &icache.resp_data3;


        // Processor <-> DCACHE
        proc.dc_req_valid = &dcache.req_valid;
        proc.dc_resp_valid = &dcache.resp_valid;

        proc.dc_req_addr = &dcache.req_addr;
        proc.dc_req_type = &dcache.req_type;
        proc.dc_req_size = &dcache.req_size;

        proc.dc_resp_err = &dcache.resp_err;

        proc.dc_resp_data0 = &dcache.resp_data0;
        proc.dc_resp_data1 = &dcache.resp_data1;
        proc.dc_resp_data2 = &dcache.resp_data2;
        proc.dc_resp_data3 = &dcache.resp_data3;

    $


    // Run all components in parallel
    behavior

        [
            run proc
            ||
            run icache
            ||
            run dcache
            ||
            run icache_wb
            ||
            run dcache_wb
        ];

    end behavior

end module



// Memory module (blocking: one request at a time)
module Memory

    parameter int MEMORY_DELAY = 40

    inport inp : width 22
    outport outp : width 17


    include $#include <cstdlib>$
    include $#include <vector>$
    include $#include <cstdint>$


    decl $

        enum MemOpType {
            IFETCH = 0,
            LOAD = 1,
            STORE = 2,
            ATOMICLOADSTORE = 3
        };

        enum MemSize {
            WORD = 0,
            DOUBLEWORD = 1,
            QUADWORD = 2
        };


        std::vector<uint8_t> mem;

        int memDelay;

        token<22> requestFromCache;
        token<17> responseToCache;

        uint32_t requestAddr;

        uint8_t requestType;
        uint8_t requestSize;

        // Data carried by a STORE (write-back) request
        uint32_t reqData0;
        uint32_t reqData1;
        uint32_t reqData2;
        uint32_t reqData3;

        uint8_t responseErr;

        uint32_t responseData0;
        uint32_t responseData1;
        uint32_t responseData2;
        uint32_t responseData3;


        bool pulled;
        bool ok;
        bool hasToken;

        int getSizeBytes(int size) {

            if(size == WORD) return 4;

            if(size == DOUBLEWORD) return 8;

            return 16;
        }


        bool isAligned(uint32_t addr, int size) {

            if(size == WORD)
                return (addr & 3) == 0;

            if(size == DOUBLEWORD)
                return (addr & 7) == 0;

            return (addr & 15) == 0;
        }


        void read_memory(uint32_t addr, int size) {

            responseData0 = 0;
            responseData1 = 0;
            responseData2 = 0;
            responseData3 = 0;

            uint32_t d[4] = {0, 0, 0, 0};

            int bytes = getSizeBytes(size);

            for(int i = 0; i < bytes / 4; i++) {

                int k = addr + i * 4;

                d[i] =
                    ((uint32_t)mem[k] << 24) |
                    ((uint32_t)mem[k+1] << 16) |
                    ((uint32_t)mem[k+2] << 8) |
                    ((uint32_t)mem[k+3]);

            }

            responseData0 = d[0];
            responseData1 = d[1];
            responseData2 = d[2];
            responseData3 = d[3];

        }


        void write_word(uint32_t addr, uint32_t data) {

            mem[addr] =
                (data >> 24) & 0xff;

            mem[addr+1] =
                (data >> 16) & 0xff;

            mem[addr+2] =
                (data >> 8) & 0xff;

            mem[addr+3] =
                data & 0xff;

        }


        // Write the data carried by the request into memory
        void write_block(uint32_t addr, int size) {

            uint32_t d[4] = {
                reqData0,
                reqData1,
                reqData2,
                reqData3
            };

            int bytes = getSizeBytes(size);

            for(int i = 0; i < bytes / 4; i++) {

                int k = addr + i * 4;

                mem[k] = (d[i] >> 24) & 0xff;
                mem[k+1] = (d[i] >> 16) & 0xff;
                mem[k+2] = (d[i] >> 8) & 0xff;
                mem[k+3] = d[i] & 0xff;

            }

        }

    $


    init $

        mem.resize(1024);

        for(int i = 0; i < 1024; i++)
            mem[i] = i & 0xff;

        memDelay = MEMORY_DELAY;

        if(const char* e = std::getenv("MEMORY_DELAY"))
            memDelay = std::atoi(e);

    $


    behavior

        do

            // Wait for request
            wait until(this_phase == 0);

            $
                hasToken =
                    inp.peek(requestFromCache);
            $;

            if(not hasToken) then
                wait
            end if;

            if(hasToken) then

                $
                    pulled =
                        inp.pull(requestFromCache);

                    sitar::unpack(
                        requestFromCache,
                        requestAddr,
                        requestType,
                        requestSize,
                        reqData0,
                        reqData1,
                        reqData2,
                        reqData3
                    );

                    responseData0 = 0;
                    responseData1 = 0;
                    responseData2 = 0;
                    responseData3 = 0;

                    responseErr = 0;

                    int bytes =
                        getSizeBytes(requestSize);


                    // Bounds check
                    if(requestAddr + bytes > 1024) {

                        responseErr = 1;

                        log << endl
                            << "Memory: OUT OF BOUNDS "
                            << "Addr="
                            << requestAddr;

                    }

                    // Alignment check
                    else if(!isAligned(
                        requestAddr,
                        requestSize
                    )) {

                        responseErr = 2;

                        log << endl
                            << "Memory: ALIGNMENT ERROR "
                            << "Addr="
                            << requestAddr;

                    }

                    else {

                        if(requestType == IFETCH) {

                            read_memory(
                                requestAddr,
                                requestSize
                            );

                        }

                        else if(requestType == LOAD) {

                            read_memory(
                                requestAddr,
                                requestSize
                            );

                        }

                        else if(requestType == STORE) {

                            write_block(
                                requestAddr,
                                requestSize
                            );

                            log << endl
                                << "Memory: WRITE-BACK received "
                                << "addr=" << requestAddr
                                << " size=" << (int)requestSize
                                << " data0=" << reqData0;

                        }

                        else if(requestType == ATOMICLOADSTORE) {

                            read_memory(
                                requestAddr,
                                requestSize
                            );

                            write_word(
                                requestAddr,
                                0x11223344
                            );

                        }

                    }

                $;


                // Memory latency
                wait(memDelay, 0);


                // Send response
                $
                    sitar::pack(
                        responseToCache,
                        responseErr,
                        responseData0,
                        responseData1,
                        responseData2,
                        responseData3
                    );
                $;


                do

                    wait until(this_phase == 1);

                    $
                        ok = outp.push(responseToCache);
                    $;

                    if(not ok) then
                        wait
                    end if;

                while(not ok) end do;

            end if;

        while(1) end do;

    end behavior

end module